{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the OneStop Agent application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user.",
          "format": "uuid"
        },
        "firstName": {
          "type": "string",
          "description": "The first name of the user."
        },
        "lastName": {
          "type": "string",
          "description": "The last name of the user."
        },
        "email": {
          "type": "string",
          "description": "The email address of the user.",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "The phone number of the user."
        },
        "createdAt": {
          "type": "string",
          "description": "The timestamp when the user was created.",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "description": "The timestamp when the user was last updated.",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "email"
      ]
    },
    "Plan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Plan",
      "type": "object",
      "description": "Represents an insurance plan.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the plan."
        },
        "provider": {
          "type": "string",
          "description": "The insurance provider."
        },
        "name": {
          "type": "string",
          "description": "The name of the plan."
        },
        "price": {
          "type": "number",
          "description": "The price of the plan."
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of coverages offered by the plan."
        },
        "type": {
          "type": "string",
          "description": "The type of insurance (e.g., motor, health, property, life)."
        },
        "deductible": {
          "type": "number",
          "description": "The deductible amount for the plan."
        }
      },
      "required": [
        "id",
        "provider",
        "name",
        "price",
        "type"
      ]
    },
    "Policy": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Policy",
      "type": "object",
      "description": "Represents an insurance policy.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the policy."
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Policy)"
        },
        "planId": {
          "type": "string",
          "description": "Reference to Plan."
        },
        "provider": {
          "type": "string",
          "description": "The insurance provider."
        },
        "name": {
          "type": "string",
          "description": "The name of the plan."
        },
        "policyNumber": {
          "type": "string",
          "description": "The policy number."
        },
        "startDate": {
          "type": "string",
          "description": "The start date of the policy.",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "description": "The end date of the policy.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Expired", "Pending"]
        }
      },
      "required": [
        "id",
        "userId",
        "planId",
        "policyNumber",
        "provider",
        "name",
        "startDate",
        "endDate",
        "status"
      ]
    },
    "Claim": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Claim",
      "type": "object",
      "description": "Represents an insurance claim.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the claim."
        },
        "policyId": {
          "type": "string",
          "description": "Reference to Policy. (Relationship: Policy 1:N Claim)"
        },
        "userId": {
          "type": "string",
          "description": "Reference to User."
        },
        "claimNumber": {
          "type": "string",
          "description": "The claim number."
        },
        "dateFiled": {
          "type": "string",
          "description": "The date the claim was filed.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Description of the claim."
        },
        "status": {
          "type": "string",
          "description": "The status of the claim (e.g., open, pending, approved, denied)."
        },
        "amount": {
          "type": "number",
          "description": "The amount claimed."
        }
      },
      "required": [
        "id",
        "policyId",
        "userId",
        "claimNumber",
        "dateFiled",
        "description",
        "status",
        "amount"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. Each document is keyed by the user's unique ID."
        }
      },
      {
        "path": "/plans/{planId}",
        "definition": {
          "entityName": "Plan",
          "schema": {
            "$ref": "#/backend/entities/Plan"
          },
          "description": "Stores all available insurance plans."
        }
      },
      {
        "path": "/users/{userId}/policies/{policyId}",
        "definition": {
          "entityName": "Policy",
          "schema": {
            "$ref": "#/backend/entities/Policy"
          },
          "description": "Stores insurance policies for each user. The userId is included in the path for ownership and security."
        }
      },
      {
        "path": "/users/{userId}/policies/{policyId}/claims/{claimId}",
        "definition": {
          "entityName": "Claim",
          "schema": {
            "$ref": "#/backend/entities/Claim"
          },
          "description": "Stores insurance claims for each policy. Nested within the policy for data locality and easy access."
        }
      }
    ]
  }
}