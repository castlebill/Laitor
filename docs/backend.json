{
  "entities": {
    "Broker": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Broker",
      "type": "object",
      "description": "Represents an insurance brokerage or agency, acting as a tenant in the system.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the broker." },
        "name": { "type": "string", "description": "The name of the brokerage." },
        "address": { "type": "string", "description": "The physical address of the brokerage." },
        "contactEmail": { "type": "string", "format": "email", "description": "Primary contact email for the brokerage." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "contactEmail"]
    },
    "InsuranceCompany": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "InsuranceCompany",
      "type": "object",
      "description": "Represents an insurance company that provides plans.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the insurance company." },
        "name": { "type": "string", "description": "The name of the insurance company." }
      },
      "required": ["id", "name"]
    },
    "Agent": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Agent",
      "type": "object",
      "description": "Represents an agent user who works for a broker.",
      "properties": {
        "id": { "type": "string", "description": "Corresponds to the Firebase Auth user ID." },
        "brokerId": { "type": "string", "description": "The ID of the broker this agent belongs to." },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "isAdmin": { "type": "boolean", "description": "Whether the agent has admin rights within their brokerage." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "brokerId", "email"]
    },
    "Customer": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Customer",
      "type": "object",
      "description": "Represents an end-user customer who purchases insurance.",
      "properties": {
        "id": { "type": "string", "description": "Corresponds to the Firebase Auth user ID." },
        "brokerId": { "type": "string", "description": "The ID of the broker managing this customer." },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "brokerId", "email"]
    },
    "Plan": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Plan",
      "type": "object",
      "description": "Represents an insurance plan offered by an insurance company.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string", "description": "Reference to InsuranceCompany." },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "coverage": { "type": "array", "items": { "type": "string" } },
        "type": { "type": "string", "enum": ["motor", "health", "property", "life"] },
        "deductible": { "type": "number" }
      },
      "required": ["id", "companyId", "name", "price", "type"]
    },
    "Policy": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Policy",
      "type": "object",
      "description": "Represents an insurance policy held by a customer.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "planId": { "type": "string" },
        "policyNumber": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Active", "Expired", "Pending"] }
      },
      "required": ["id", "customerId", "planId", "policyNumber", "startDate", "endDate", "status"]
    },
    "Claim": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Claim",
      "type": "object",
      "description": "Represents an insurance claim on a policy.",
      "properties": {
        "id": { "type": "string" },
        "policyId": { "type": "string" },
        "customerId": { "type": "string" },
        "claimNumber": { "type": "string" },
        "dateFiled": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Processing", "Approved", "Rejected", "Pending"] },
        "amount": { "type": "number" }
      },
      "required": ["id", "policyId", "customerId", "claimNumber", "dateFiled", "description", "status", "amount"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/brokers/{brokerId}",
        "definition": {
          "entityName": "Broker",
          "schema": { "$ref": "#/backend/entities/Broker" }
        }
      },
      {
        "path": "/insuranceCompanies/{companyId}",
        "definition": {
          "entityName": "InsuranceCompany",
          "schema": { "$ref": "#/backend/entities/InsuranceCompany" }
        }
      },
      {
        "path": "/brokers/{brokerId}/agents/{agentId}",
        "definition": {
          "entityName": "Agent",
          "schema": { "$ref": "#/backend/entities/Agent" }
        }
      },
      {
        "path": "/brokers/{brokerId}/customers/{customerId}",
        "definition": {
          "entityName": "Customer",
          "schema": { "$ref": "#/backend/entities/Customer" }
        }
      },
      {
        "path": "/plans/{planId}",
        "definition": {
          "entityName": "Plan",
          "schema": { "$ref": "#/backend/entities/Plan" }
        }
      },
      {
        "path": "/brokers/{brokerId}/customers/{customerId}/policies/{policyId}",
        "definition": {
          "entityName": "Policy",
          "schema": { "$ref": "#/backend/entities/Policy" }
        }
      },
      {
        "path": "/brokers/{brokerId}/customers/{customerId}/policies/{policyId}/claims/{claimId}",
        "definition": {
          "entityName": "Claim",
          "schema": { "$ref": "#/backend/entities/Claim" }
        }
      }
    ]
  }
}
